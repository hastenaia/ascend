# Supabase — Ascend (fresh project, isolated from Nimbus)
# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://fpspwpmxlnfsegcwqeir.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f66j5apLYTqJs7IE1vHAlw_ZphpVRTI

# Optional server-only (never expose to client) — only if you add service_role usage in API routes
# SUPABASE_SERVICE_ROLE_KEY=

# Netlify — set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in Netlify → Configuration → Environment variables
# Supabase → Auth → URL Configuration → add https://<your-netlify-domain>.netlify.app and https://<your-netlify-domain>.netlify.app/auth/callback (+ http://localhost:3000/auth/callback)

# AI Coach — Google Gemini (server-side only, never exposed to the browser)
# Without GEMINI_API_KEY the Edge Function ai-coach responds with 'AI Coach is currently unavailable.' and no fake content.
# Preferred: set GEMINI_API_KEY as Supabase Edge Function secret: supabase secrets set GEMINI_API_KEY="YOUR_KEY"
# For local Next.js routes (fallback), set GEMINI_API_KEY in .env.local
GEMINI_API_KEY=
# Legacy fallback (OpenAI-compatible) — only used if GEMINI_API_KEY is not set
# AI_API_KEY is deprecated, use GEMINI_API_KEY
AI_API_KEY=
# Optional: model overrides (Edge Function uses gemini-2.5-flash by default)
#GEMINI_MODEL=gemini-2.5-flash
# Legacy OpenAI-compatible endpoint + model (deprecated)
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini
